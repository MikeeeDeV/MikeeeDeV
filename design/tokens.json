{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Kemet Nocturne",
  "description": "Design tokens for Mohamed Ayman (MikeeeDeV) GitHub profile: Egyptian obsidian, electrum gold, lapis lazuli and deterministic systems typography.",
  "version": "1.0.0",
  "colors": {
    "dark": {
      "bg": "#0A0E14",
      "card_bg": "#111822",
      "card_elevated": "#182230",
      "border": "#223348",
      "border_accent": "#3B5372",
      "text_primary": "#E2E8F0",
      "text_secondary": "#94A3B8",
      "text_muted": "#64748B",
      "accent_gold": "#E5C07B",
      "accent_lapis": "#3898EC",
      "accent_teal": "#2DD4BF",
      "accent_coral": "#F43F5E",
      "terminal_green": "#2DD4BF",
      "terminal_yellow": "#E5C07B",
      "terminal_blue": "#3898EC",
      "terminal_purple": "#C678DD"
    },
    "light": {
      "bg": "#F8FAFC",
      "card_bg": "#FFFFFF",
      "card_elevated": "#F1F5F9",
      "border": "#CBD5E1",
      "border_accent": "#94A3B8",
      "text_primary": "#0F172A",
      "text_secondary": "#475569",
      "text_muted": "#64748B",
      "accent_gold": "#B48924",
      "accent_lapis": "#1E6BB8",
      "accent_teal": "#0D9488",
      "accent_coral": "#E11D48",
      "terminal_green": "#0D9488",
      "terminal_yellow": "#B48924",
      "terminal_blue": "#1E6BB8",
      "terminal_purple": "#9333EA"
    }
  },
  "typography": {
    "font_mono": "ui-monospace, 'JetBrains Mono', 'SF Mono', 'Fira Code', 'Menlo', monospace",
    "font_sans": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Cairo', sans-serif",
    "font_arabic": "'Cairo', 'Amiri', 'Noto Sans Arabic', 'Segoe UI', system-ui, sans-serif",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "geometry": {
    "card_radius": 8,
    "badge_radius": 4,
    "border_width": 1,
    "rosette_points": 8
  },
  "motion": {
    "pulse_duration": "2.4s",
    "typewriter_cursor_duration": "0.9s"
  }
}
